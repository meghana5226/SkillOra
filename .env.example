# ===== Database =====
# For docker compose the backend connects to the "postgres" service automatically.
# For local (non-Docker) backend runs or Render, set your real values:
DATABASE_URL=jdbc:postgresql://localhost:5432/skillora
DATABASE_USERNAME=skillora
DATABASE_PASSWORD=change-me

# ===== Security =====
# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# ===== CORS =====
# Comma-separated list of allowed frontend origins (no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Demo data =====
SEED_ENABLED=true
DEMO_PASSWORD=Demo@1234

# ===== Frontend (build-time) =====
VITE_API_BASE_URL=http://localhost:8080
